<?xml version="1.0" encoding="utf-8"?>
<!--
  撮影データは端末内に留める。クラウドバックアップにも端末間転送にも載せない。
  ネットワーク送信機構を持たないアプリなので、バックアップ経由で外に出るのも防ぐ。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
